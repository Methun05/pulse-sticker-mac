# Database (PostgreSQL — Neon/Supabase/Vercel Postgres)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Public Application URL
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Admin Portal Password
ADMIN_PASSWORD=your_secure_admin_password

# Deposit Addresses (comma-separated, 2 per chain for rotation)
# Use the same addresses across chains if you want, or different ones
DEPOSIT_ADDRESSES_1=0xYourEthAddress1,0xYourEthAddress2
DEPOSIT_ADDRESSES_56=0xYourBscAddress1,0xYourBscAddress2
DEPOSIT_ADDRESSES_369=0xYourPulseChainAddress1,0xYourPulseChainAddress2
DEPOSIT_ADDRESSES_8453=0xYourBaseAddress1,0xYourBaseAddress2
DEPOSIT_ADDRESSES_137=0xYourPolygonAddress1,0xYourPolygonAddress2

# Fallback: if chain-specific not set, uses this for all chains
DEPOSIT_ADDRESSES=0xYourAddress1,0xYourAddress2

# RPC Endpoints (optional — defaults to free public RPCs)
# ETH_RPC_URL=https://ethereum-rpc.publicnode.com
# ETH_FALLBACK_RPC_URL=https://cloudflare-eth.com
# BSC_RPC_URL=https://bsc-dataseed.binance.org
# PULSECHAIN_RPC_URL=https://rpc.pulsechain.com
# BASE_RPC_URL=https://mainnet.base.org
# POLYGON_RPC_URL=https://polygon-rpc.com
