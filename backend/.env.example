# Server
PORT=4000

# NOWPayments (https://nowpayments.io) — used for PLS, USDC/USDT/BNB on
# Ethereum/BSC/Solana/Polygon. See context/context.md section 3.1 / 4.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# Wallet address NOWPayments should forward confirmed funds to, if applicable.
PAYOUT_WALLET_ADDRESS=

# PulseChain manual/stateless verifier — used for PulseChain-native tokens
# (PLS-native transfers, pDAI, PulseChain-bridged USDC/USDT). See
# context/context.md section 3.4 / 4. Do NOT use the free public RPC in
# production — it rate-limits and drops under load. Use a paid/managed
# provider (e.g. Moralis PulseChain RPC).
PULSECHAIN_RPC_URL=https://rpc.pulsechain.com
PULSECHAIN_CHAIN_ID=369
# Address that receives PulseChain-native payments.
RECEIVING_WALLET_ADDRESS=

# Contract addresses for PulseChain-native tokens we accept. LEAVE BLANK
# until confirmed via the official PulseChain bridge (bridge.pulsechain.com)
# — see context/context.md section 3.2. Never guess these; wrong values
# mean buyers could pay into the wrong token, or worse, a worthless
# fork-copy / scam impersonator.
PULSECHAIN_PDAI_CONTRACT=
PULSECHAIN_USDC_CONTRACT=
PULSECHAIN_USDT_CONTRACT=

# Minimum confirmations required before a PulseChain payment is accepted.
PULSECHAIN_MIN_CONFIRMATIONS=6
