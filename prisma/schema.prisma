generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Board {
  id          String   @id @default(cuid())
  title       String   @default("PulseChain MacBook Sticker Board")
  status      String   @default("LIVE") // LIVE, PAUSED
  totalRaised Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  spots       Spot[]
}

model Spot {
  id               String   @id @default(cuid())
  boardId          String
  board            Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  number           Int      @unique // 1-10
  position         String   // "Center Lid", "Upper Left", etc.
  size             String   // "XL", "Large", "Medium", "Small"
  tier             String   @default("PHYSICAL") // PHYSICAL (top 10 get sticker), DIGITAL (board only)
  startingPrice    Float    @default(1) // $1 minimum
  currentBid       Float    @default(0)
  currentBrandName String?
  currentLogoUrl   String?
  currentWebsite   String?
  currentWallet    String?  // wallet address of current highest bidder
  status           String   @default("AVAILABLE") // AVAILABLE, OCCUPIED
  bidCount         Int      @default(0)
  clicksCount      Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  bids             Bid[]
}

model Bid {
  id            String   @id @default(cuid())
  spotId        String
  spot          Spot     @relation(fields: [spotId], references: [id], onDelete: Cascade)
  walletAddress String
  brandName     String
  website       String?
  logoUrl       String?
  amount        Float    // USD value at time of bid
  status        String   @default("PENDING") // PENDING, CONFIRMED, OUTBID, CANCELLED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  payment       Payment?
}

model Payment {
  id              String   @id @default(cuid())
  bidId           String   @unique
  bid             Bid      @relation(fields: [bidId], references: [id], onDelete: Cascade)
  txHash          String?  @unique
  chainId         Int      // 1=Ethereum, 56=BSC, 369=PulseChain
  token           String   // "ETH", "USDC", "USDT", "DAI", "BNB"
  tokenAmount     String   // raw amount in base units (wei, micro-USDC, etc.)
  usdAmount       Float    // USD equivalent at time of payment
  depositAddress  String   // which of our addresses received it
  walletAddress   String   // sender's wallet
  status          String   @default("PENDING") // PENDING, CONFIRMING, CONFIRMED, FAILED, EXPIRED
  startBlock      Int?     // block number at payment creation
  startBalance    String?  // starting balance (for native token detection)
  expiresAt       DateTime? // payment window expiry
  confirmedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AdminConfig {
  id        String  @id @default("default_config")
  siteActive Boolean @default(true)
  pageViews Int     @default(0)
  updatedAt DateTime @updatedAt
}
